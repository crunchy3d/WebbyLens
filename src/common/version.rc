// Version resource shared by all WebbyLens binaries.
// Compile with /d FILE_DESC="..." /d FILE_NAME="..." (see build.bat).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WEBBYLENS_VERSION_RC
 PRODUCTVERSION WEBBYLENS_VERSION_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Damir Vrancic and Claude"
            VALUE "FileDescription",  FILE_DESC
            VALUE "FileVersion",      WEBBYLENS_VERSION_STRING
            VALUE "InternalName",     FILE_NAME
            VALUE "OriginalFilename", FILE_NAME
            VALUE "ProductName",      "WebbyLens"
            VALUE "ProductVersion",   WEBBYLENS_VERSION_STRING
            VALUE "LegalCopyright",   "Copyright (c) 2026 Damir Vrancic. MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
